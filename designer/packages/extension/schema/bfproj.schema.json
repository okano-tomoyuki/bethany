    "mainForm": {
      "type": "string"
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "autoCreate": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "formatVersion"
  ],
  "additionalProperties": false
}
