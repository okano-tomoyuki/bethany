{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "codegen": {
      "type": "object",
      "properties": {
        "commentLocale": {
          "type": "string",
          "enum": [
            "en",
            "ja"
          ]
        },
        "cpp": {
          "type": "object",
          "properties": {
            "main": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "python": {
          "type": "object",
          "properties": {
            "main": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "mainForm": {
      "type": "string"
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "autoCreate": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "formatVersion"
  ],
  "additionalProperties": false
}
