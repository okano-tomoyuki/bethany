{
  "name": "bethany-designer",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "private": true,
  "publisher": "okano-tomoyuki",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#55692E",
    "theme": "dark"
  },
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/okano-tomoyuki/bethany.git",
    "directory": "designer/packages/extension"
  },
  "homepage": "https://github.com/okano-tomoyuki/bethany/tree/master/designer",
  "bugs": {
    "url": "https://github.com/okano-tomoyuki/bethany/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "bethany",
    "lcl",
    "lazarus",
    "form designer",
    "gui",
    "c++builder"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:json"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "bethanyDesigner.designer",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.bfm.json"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bethanyDesigner",
          "title": "%viewContainer.title%",
          "icon": "images/activitybar.svg"
        }
      ]
    },
    "views": {
      "bethanyDesigner": [
        {
          "id": "bethanyDesigner.forms",
          "name": "%view.forms.name%",
          "icon": "images/activitybar.svg",
          "contextualTitle": "%viewContainer.title%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "bethanyDesigner.forms",
        "contents": "%view.forms.welcome%"
      }
    ],
    "commands": [
      {
        "command": "bethanyDesigner.newForm",
        "title": "%command.newForm.title%",
        "shortTitle": "%command.newForm.shortTitle%",
        "category": "Bethany Designer",
        "icon": "$(add)"
      },
      {
        "command": "bethanyDesigner.generateCode",
        "title": "%command.generateCode.title%",
        "category": "Bethany Designer",
        "icon": "$(code)"
      },
      {
        "command": "bethanyDesigner.refreshForms",
        "title": "%command.refreshForms.title%",
        "category": "Bethany Designer",
        "icon": "$(refresh)"
      },
      {
        "command": "bethanyDesigner.newProject",
        "title": "%command.newProject.title%",
        "category": "Bethany Designer",
        "icon": "$(new-folder)"
      },
      {
        "command": "bethanyDesigner.setMainForm",
        "title": "%command.setMainForm.title%",
        "category": "Bethany Designer",
        "icon": "$(star-empty)"
      },
      {
        "command": "bethanyDesigner.addToProject",
        "title": "%command.addToProject.title%",
        "category": "Bethany Designer"
      },
      {
        "command": "bethanyDesigner.removeFromProject",
        "title": "%command.removeFromProject.title%",
        "category": "Bethany Designer"
      },
      {
        "command": "bethanyDesigner.openProjectFile",
        "title": "%command.openProjectFile.title%",
        "category": "Bethany Designer",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "bethanyDesigner.newForm",
          "group": "navigation@10"
        }
      ],
      "file/newFile": [
        {
          "command": "bethanyDesigner.newForm"
        }
      ],
      "editor/title": [
        {
          "command": "bethanyDesigner.generateCode",
          "when": "resourceFilename =~ /\\.bfm\\.json$/",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "bethanyDesigner.newForm",
          "when": "view == bethanyDesigner.forms",
          "group": "navigation@1"
        },
        {
          "command": "bethanyDesigner.refreshForms",
          "when": "view == bethanyDesigner.forms",
          "group": "navigation@2"
        },
        {
          "command": "bethanyDesigner.newProject",
          "when": "view == bethanyDesigner.forms",
          "group": "1_project@1"
        }
      ],
      "view/item/context": [
        {
          "command": "bethanyDesigner.newForm",
          "when": "view == bethanyDesigner.forms && viewItem == project",
          "group": "inline"
        },
        {
          "command": "bethanyDesigner.generateCode",
          "when": "view == bethanyDesigner.forms && viewItem =~ /^(form|projectForm|projectMainForm)$/",
          "group": "inline"
        },
        {
          "command": "bethanyDesigner.generateCode",
          "when": "view == bethanyDesigner.forms && viewItem =~ /^(form|projectForm|projectMainForm)$/",
          "group": "navigation@1"
        },
        {
          "command": "bethanyDesigner.newForm",
          "when": "view == bethanyDesigner.forms && viewItem == project",
          "group": "navigation@1"
        },
        {
          "command": "bethanyDesigner.openProjectFile",
          "when": "view == bethanyDesigner.forms && viewItem =~ /^(project|brokenProject)$/",
          "group": "navigation@2"
        },
        {
          "command": "bethanyDesigner.setMainForm",
          "when": "view == bethanyDesigner.forms && viewItem =~ /^(form|projectForm)$/",
          "group": "2_project@1"
        },
        {
          "command": "bethanyDesigner.addToProject",
          "when": "view == bethanyDesigner.forms && viewItem =~ /^(form|projectForm|projectMainForm)$/",
          "group": "2_project@2"
        },
        {
          "command": "bethanyDesigner.removeFromProject",
          "when": "view == bethanyDesigner.forms && viewItem =~ /^project(Main|Missing)?Form$/",
          "group": "2_project@3"
        }
      ],
      "commandPalette": [
        {
          "command": "bethanyDesigner.generateCode",
          "when": "resourceFilename =~ /\\.bfm\\.json$/"
        },
        {
          "command": "bethanyDesigner.refreshForms",
          "when": "view.bethanyDesigner.forms.visible"
        },
        {
          "command": "bethanyDesigner.setMainForm",
          "when": "false"
        },
        {
          "command": "bethanyDesigner.addToProject",
          "when": "false"
        },
        {
          "command": "bethanyDesigner.removeFromProject",
          "when": "false"
        },
        {
          "command": "bethanyDesigner.openProjectFile",
          "when": "false"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "*.bfm.json",
        "url": "./schema/bfm.schema.json"
      },
      {
        "fileMatch": "*.bfproj.json",
        "url": "./schema/bfproj.schema.json"
      }
    ],
    "configuration": {
      "title": "Bethany Designer",
      "properties": {
        "bethanyDesigner.canvas.fontFamily": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.canvas.fontFamily%"
        },
        "bethanyDesigner.canvas.fontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%config.canvas.fontSize%"
        },
        "bethanyDesigner.canvas.gridSize": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "markdownDescription": "%config.canvas.gridSize%"
        },
        "bethanyDesigner.canvas.showGrid": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.canvas.showGrid%"
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --main-fields=module,main --sourcemap --outfile=dist/extension.cjs",
    "vscode:prepublish": "pnpm --filter @bethany-designer/webview run build && pnpm run build",
    "typecheck": "tsc -p tsconfig.json",
    "package": "vsce package --no-dependencies",
    "generate:schema": "node scripts/generate-json-schema.mts",
    "check:schema": "node scripts/generate-json-schema.mts --check",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --main-fields=module,main --sourcemap --outfile=dist/extension.cjs --watch=forever"
  },
  "dependencies": {
    "@bethany-designer/codegen": "workspace:*",
    "@bethany-designer/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2"
  },
  "l10n": "./l10n"
}
