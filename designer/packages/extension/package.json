{
  "name": "bethany-designer",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.1",
  "private": true,
  "publisher": "okano-tomoyuki",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Visual Designers"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:json"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "bethanyDesigner.designer",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.bfm.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "bethanyDesigner.newForm",
        "title": "%command.newForm.title%",
        "shortTitle": "%command.newForm.shortTitle%",
        "category": "Bethany Designer"
      },
      {
        "command": "bethanyDesigner.generateCode",
        "title": "%command.generateCode.title%",
        "category": "Bethany Designer",
        "icon": "$(code)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "bethanyDesigner.newForm",
          "group": "navigation@10"
        }
      ],
      "file/newFile": [
        {
          "command": "bethanyDesigner.newForm"
        }
      ],
      "editor/title": [
        {
          "command": "bethanyDesigner.generateCode",
          "when": "resourceFilename =~ /\\.bfm\\.json$/",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "bethanyDesigner.generateCode",
          "when": "resourceFilename =~ /\\.bfm\\.json$/"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "*.bfm.json",
        "url": "./schema/bfm.schema.json"
      }
    ],
    "configuration": {
      "title": "Bethany Designer",
      "properties": {
        "bethanyDesigner.canvas.fontFamily": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.canvas.fontFamily%"
        },
        "bethanyDesigner.canvas.fontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%config.canvas.fontSize%"
        },
        "bethanyDesigner.canvas.gridSize": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "markdownDescription": "%config.canvas.gridSize%"
        },
        "bethanyDesigner.canvas.showGrid": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.canvas.showGrid%"
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --main-fields=module,main --sourcemap --outfile=dist/extension.cjs",
    "typecheck": "tsc -p tsconfig.json",
    "package": "vsce package --no-dependencies",
    "generate:schema": "node scripts/generate-json-schema.mts",
    "check:schema": "node scripts/generate-json-schema.mts --check",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --main-fields=module,main --sourcemap --outfile=dist/extension.cjs --watch=forever"
  },
  "dependencies": {
    "@bethany-designer/codegen": "workspace:*",
    "@bethany-designer/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2"
  },
  "l10n": "./l10n"
}
