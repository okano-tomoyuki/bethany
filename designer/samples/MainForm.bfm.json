{
  "formatVersion": 1,
  "form": {
    "name": "MainForm",
    "class": "TForm",
    "properties": {
      "Width": 400,
      "Height": 300,
      "Caption": "Sample",
      "Menu": "MainMenu1",
      "AllowDropFiles": true
    },
    "events": {
      "OnCreate": "FormCreate",
      "OnCloseQuery": "FormCloseQuery",
      "OnDropFiles": "FormDropFiles"
    },
    "controls": [
      {
        "name": "NameEdit",
        "class": "TEdit",
        "properties": {
          "Left": 16,
          "Top": 16,
          "Width": 280,
          "Height": 23,
          "Anchors": ["akTop", "akLeft", "akRight"],
          "Hint": "Your name",
          "ShowHint": true
        },
        "events": { "OnChange": "NameEditChange" }
      },
      {
        "name": "OkButton",
        "class": "TButton",
        "properties": {
          "Left": 304,
          "Top": 15,
          "Width": 75,
          "Height": 25,
          "Caption": "&OK",
          "Font": { "Style": ["fsBold"] },
          "Anchors": ["akTop", "akRight"]
        },
        "events": { "OnClick": "OkButtonClick" }
      },
      {
        "name": "PageControl1",
        "class": "TPageControl",
        "properties": {
          "Left": 16,
          "Top": 48,
          "Width": 363,
          "Height": 120,
          "Anchors": ["akTop", "akLeft", "akRight"],
          "ActivePage": "MemoSheet"
        },
        "controls": [
          {
            "name": "OptionSheet",
            "class": "TTabSheet",
            "properties": {
              "Caption": "Options"
            },
            "controls": [
              {
                "name": "WrapCheck",
                "class": "TCheckBox",
                "properties": {
                  "Left": 8,
                  "Top": 8,
                  "Width": 80,
                  "Height": 19,
                  "Caption": "Word wrap",
                  "Checked": true
                },
                "events": { "OnClick": "WrapCheckClick" }
              },
              {
                "name": "SizeSpin",
                "class": "TSpinEdit",
                "properties": {
                  "Left": 8,
                  "Top": 36,
                  "Width": 80,
                  "Height": 23,
                  "MaxValue": 200,
                  "Value": 150
                }
              },
              {
                "name": "OptionStatus",
                "class": "TStatusBar",
                "properties": {
                  "Left": 0,
                  "Top": 68,
                  "Width": 355,
                  "Height": 24,
                  "SimplePanel": false,
                  "Panels": [
                    { "Text": "Ready", "Width": 120 },
                    { "Width": 60, "Style": "psOwnerDraw" },
                    { "Text": "right", "Alignment": "taRightJustify", "Bevel": "pbNone" }
                  ]
                }
              }
            ]
          },
          {
            "name": "MemoSheet",
            "class": "TTabSheet",
            "properties": {
              "Caption": "Memo"
            },
            "controls": [
              {
                "name": "Memo1",
                "class": "TMemo",
                "properties": {
                  "Left": 0,
                  "Top": 0,
                  "Width": 355,
                  "Height": 92,
                  "Align": "alClient",
                  "PopupMenu": "PopupMenu1",
                  "ScrollBars": 3,
                  "Lines": ["line 1", "line \"2\""]
                }
              }
            ]
          }
        ]
      },
      {
        "name": "BottomPanel",
        "class": "TPanel",
        "properties": {
          "Left": 0,
          "Top": 259,
          "Width": 400,
          "Height": 41,
          "Caption": "",
          "Align": "alBottom",
          "Color": "#FFF0C0"
        },
        "controls": [
          {
            "name": "StatusLabel",
            "class": "TLabel",
            "properties": {
              "Left": 8,
              "Top": 12,
              "Width": 36,
              "Height": 17,
              "Caption": "Ready",
              "Font": { "Size": 10, "Color": "clBlue" }
            }
          }
        ]
      }
    ]
  },
  "components": [
    {
      "name": "MainMenu1",
      "class": "TMainMenu",
      "design": { "left": 16, "top": 200 },
      "items": [
        {
          "name": "FileMenu",
          "properties": {
            "Caption": "&File"
          },
          "items": [
            {
              "name": "FileOpenItem",
              "properties": {
                "Caption": "&Open...",
                "ShortCut": "Ctrl+O"
              },
              "events": { "OnClick": "FileOpenItemClick" }
            },
            {
              "name": "FileSaveItem",
              "properties": {
                "Action": "FileSaveAction"
              }
            },
            {
              "name": "N1",
              "properties": {
                "Caption": "-"
              }
            },
            {
              "name": "FileExitItem",
              "properties": {
                "Caption": "E&xit"
              },
              "events": { "OnClick": "FileExitItemClick" }
            }
          ]
        }
      ]
    },
    {
      "name": "PopupMenu1",
      "class": "TPopupMenu",
      "design": { "left": 56, "top": 200 },
      "items": [
        {
          "name": "ClearItem",
          "properties": {
            "Caption": "Clear"
          },
          "events": { "OnClick": "ClearItemClick" }
        }
      ]
    },
    {
      "name": "OpenDialog1",
      "class": "TOpenDialog",
      "design": { "left": 96, "top": 200 },
      "properties": {
        "Filter": "Text files|*.txt|All files|*.*",
        "Options": ["ofEnableSizing", "ofViewDetail", "ofFileMustExist"]
      }
    },
    {
      "name": "Timer1",
      "class": "TTimer",
      "design": { "left": 136, "top": 200 },
      "properties": {
        "Interval": 500,
        "Enabled": false
      },
      "events": { "OnTimer": "Timer1Timer" }
    },
    {
      "name": "ActionList1",
      "class": "TActionList",
      "design": { "left": 176, "top": 200 },
      "actions": [
        {
          "name": "FileSaveAction",
          "properties": {
            "Category": "File",
            "Caption": "&Save",
            "ShortCut": "Ctrl+S"
          },
          "events": { "OnExecute": "FileSaveActionExecute" }
        }
      ]
    }
  ]
}
