@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/bethTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/BethDeploy.cmake")

if(WIN32)
    set_property(GLOBAL PROPERTY BETH_DLL "${PACKAGE_PREFIX_DIR}/bin/beth.dll")
else()
    set_property(GLOBAL PROPERTY BETH_DLL "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libbeth.so")
endif()

# manifest の .rc は manifest の絶対パスを埋めるため、利用者のビルドフォルダに作り直す(CMakeLists.txt の BETH_EMBED_MANIFEST)。
# find_package が同じディレクトリで 2 回呼ばれても、.rc を 2 回加えない。
get_target_property(_beth_sources beth::beth INTERFACE_SOURCES)
if(WIN32 AND @BETH_EMBED_MANIFEST@ AND NOT _beth_sources MATCHES "beth_manifest\.rc")
    enable_language(RC)
    set(BETH_MANIFEST_PATH "${CMAKE_CURRENT_LIST_DIR}/beth.manifest")
    configure_file("${CMAKE_CURRENT_LIST_DIR}/beth_manifest.rc.in" "${CMAKE_BINARY_DIR}/beth_manifest.rc" @ONLY)
    target_sources(beth::beth INTERFACE "${CMAKE_BINARY_DIR}/beth_manifest.rc")
endif()

check_required_components(beth)
